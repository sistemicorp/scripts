// Example: Connects to an Agilent DSO7000 DSO via VISA
// !! NOTE: This example will only load if there is an Agilent DSO7000 Series on USB !!
// One scope is shared by all channels, {"shared": true}, so the Fake hardware sets
// the number of channels, and scope input <channel + 1> is wired to each jig.
// For a scope on Ethernet, add to the driver arguments,
//   "interface": "ethernet", "ip": "192.168.1.100"
// For one scope per channel, remove the fake driver and "shared", and on Ethernet
// give one IP per channel, "ip": ["192.168.1.100", "192.168.1.101"]
{
  "info": {
    "product": "pybrd_1",
    "bom": "B00100-001",
    "lot": "95135",
    "location": "canada/ontario/milton"
  },
  "config": {
    "fail_fast": false,
    "drivers": [
      "public.prism.drivers.fake.hwdrv_fake",
      ["public.prism.drivers.agilent_dso_usb_1.hwdrv_agilent_dso_usb_1", {"shared": true}]
    ]
  },
  "tests": [
    {
      "module": "public.prism.scripts.example.dso_v0.pydso",
      "options": {},
      "items": [
        {"id": "PYDSO000SETUP",     "enable": true },
        {"id": "PYDSO010SETCHAN",   "enable": true, "chan": 1 },
        {"id": "PYDSO010SETCHAN",   "enable": true, "chan": 2 },
        {"id": "PYDSO010SETCHAN",   "enable": true, "chan": 3 },
        {"id": "PYDSO010SETCHAN",   "enable": true, "chan": 4 },
        {"id": "PYDSO999TRDN",      "enable": true }
      ]
    }
  ]
}