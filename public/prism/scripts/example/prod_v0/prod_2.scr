// Example: Shows substitution being used in more than one place.
//          Shows multiple modules being used.
{
  "subs": {
    "Lot": {
      "title": "Lot (format #####)",
      "type" : "str", "widget": "textinput", "regex": "\\d{5}", "default": "95035"
    },
    "Loc": {
      "title": "Location",
      "type" : "str", "widget": "select", "choices": ["canada/ontario/milton", "us/newyork/bufalo"]
    },
    "TST010Max": {
      "title": "TST010 Max Attenuation (db)",
      "type" : "num", "widget": "select", "choices": [9, 10]
    },
    "TST510Max": {
      "title": "TST510 Max Attenuation (db)",
      "type" : "num", "widget": "select", "choices": [11.1, 12.2, 13.3]
    }
  },
  "info": {
    "product": "widget_1",
    "bom": "B00012-003",
    // list fields present user choice or fill in
    "lot": "%%Lot",
    "location": "%%Loc"
  },
  "config": {
    "fail_fast": false,
    "drivers": ["public.prism.drivers.fake.hwdrv_fake"]
  },
  "tests": [
    {
      "module": "public.prism.scripts.example.prod_v0.tst00xx",
      "options": {
        "fail_fast": false
      },
      "items": [
        {"id": "TST000_SETUP",    "enable": true },
        {"id": "TST010_meas",     "enable": true, "min": 0, "max": "%%TST010Max",
                                  "fail": [ {"fid": "TST010-1", "msg": "Component apple R1"},
                                            {"fid": "TST010-2", "msg": "Component banana R1"}] },
        {"id": "TST030_skip",     "enable": false },

        // always called, no matter if test fails above
        {"id": "TST990_TEARDOWN", "enable": true },
      ]
    },
    {
      "module": "public.prism.scripts.example.prod_v0.tst01xx",
      "options": {
        "fail_fast": false
      },
      "items": [
        {"id": "TST500_SETUP",    "enable": true },
        {"id": "TST510_meas",     "enable": true,  "min": 0, "max": "%%TST510Max",
                                  "fail": [ {"fid": "TST510-1", "msg": "Component R1"} ] },
        {"id": "TST520_skip",     "enable": false },

        // always called, no matter if test fails above
        {"id": "TST990_TEARDOWN", "enable": true },
      ]
    }
  ]
}