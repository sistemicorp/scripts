// !! CAN ONLY RUN THIS ONCE IN PRISM !!
//
// Example: update the firmware of the attached BONDs to assets/teensy4_server.ino.hex
// !! NOTE: Only works if there is a BOND on USB !!
// !!       See public/prism/drivers/A4401_BOND/server/README.md for provision instructions
// !!
// 1) The BOND has been previously programmed with a BOND server firmware, any version.
//    hwdrv_A4401_BOND_update does not check the firmware version, so an older BOND
//    can be updated.  A new (never programmed) BOND uses bond_progfresh_0.scr.
// 2) Can only run once in prism because after firmware update, USB re-enumeration
//    may cause the Teensy to change ports, and mess up the hwdrv init.
// 3) Arduino IDE must not be running else it will jump in and mess things up when Teensy reboots.
// 4) The jig does not need to be closed, no Pogo board is needed.
//
// !! CAN ONLY RUN THIS ONCE IN PRISM !!
{
  "info": {
    "product": "BOND",
    "bom": "a4401",
    "lot": "NA",
    "location": "here"
  },
  "config": {
    "fail_fast": true,
    "drivers": ["public.prism.drivers.A4401_BOND.hwdrv_A4401_BOND_update"]
  },
  "tests": [
    {
      "module": "public.prism.scripts.example.BOND_v0.bond_P00xx",
      "options": {
      },
      "items": [
        {"id": "UPD000_SETUP",     "enable": true, "timeout": 30 },
        {"id": "UPD010_update",    "enable": true, "file": "teensy4_server.ino.hex" },
        {"id": "UPD020_verify",    "enable": true, "delay": 24, "timeout": 30 },
        {"id": "PROG990_TEARDOWN", "enable": true}
      ]
    }
  ]
}
