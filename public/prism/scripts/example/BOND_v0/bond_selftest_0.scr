// BOND Example self test Script
// - NO POGO board or DUT should be connected to BOND
// - uses self test signals as example
{
  "info": {
    "product": "BOND",
    "bom": "a4401",
    "lot": "NA",
    "location": "here"
  },
  "config": {
    "fail_fast": true,
    "drivers": [["public.prism.drivers.A4401_BOND.hwdrv_A4401_BOND",
                 "public/prism/scripts/example/BOND_v0/assets/pogo_hdr_definition._json"]]
  },
  "tests": [
    {
      "module": "public.prism.scripts.example.BOND_v0.bond_P00xx",
      "options": {},
      "items": [
        {"id": "BOND000_SETUP",         "enable": true },
        {"id": "BOND010_led",           "enable": true, "set": true },
        {"id": "BOND020_version",       "enable": true },
        {"id": "BOND010_led",           "enable": true, "set": false },
        {"id": "BOND030_adc_check",     "enable": true, "hdr": 1 },
        {"id": "BOND030_adc_check",     "enable": true, "hdr": 2 },
        {"id": "BOND030_adc_check",     "enable": true, "hdr": 3 },
        {"id": "BOND030_adc_check",     "enable": true, "hdr": 4 },
        {"id": "BOND040_voltage_check", "enable": true, "voltage": "V6V" },
        {"id": "BOND040_voltage_check", "enable": true, "voltage": "V5V" },
        {"id": "BOND040_voltage_check", "enable": true, "voltage": "V3V3A" },
        {"id": "BOND040_voltage_check", "enable": true, "voltage": "V3V3D" },
        {"id": "BOND050_vbat_check",    "enable": true, "voltage_mv": 3000 },
        {"id": "BOND050_vbat_check",    "enable": true, "voltage_mv": 4000 },
        {"id": "BOND060_vdut_check",    "enable": true, "voltage_mv": 3000 },
        {"id": "BOND060_vdut_check",    "enable": true, "voltage_mv": 4000 },
        {"id": "BOND990_TEARDOWN",      "enable": true }
      ]
    }
  ]
}
